# nix-direnv caches the evaluated shell, so the shellHook (and therefore
# `uv sync`) only re-runs when one of these files changes. Watching the uv
# files means editing dependencies triggers a resync on your next `cd` in.
watch_file flake.nix
watch_file flake.lock
watch_file pyproject.toml
watch_file uv.lock

use flake
